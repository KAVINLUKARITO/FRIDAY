# Create console
console = Console()


def format_duration(seconds: float) -> str:
    """Format duration in human-readable form."""
    if seconds < 60:
        return f"{int(seconds)}s"
    elif seconds < 3600:
        minutes = int(seconds // 60)
        secs = int(seconds % 60)
        return f"{minutes}m {secs}s"
    else:
        hours = int(seconds // 3600)
        minutes = int((seconds % 3600) // 60)
        return f"{hours}h {minutes}m"


def get_memory_bar(used_gb: float, total_gb: float = 32.0, width: int = 32) -> str:
    """Create ASCII memory bar."""
    percent = used_gb / total_gb
    filled = int(width * percent)
    bar = "█" * filled + "░" * (width - filled)
    return f"[{bar}] {used_gb:.1f}GB / {total_gb:.0f}GB"


def get_progress_bar(current: int, total: int, width: int = 32) -> str:
    """Create ASCII progress bar."""
    if total == 0:
        return "[" + "░" * width + "] 0%"
    percent = current / total
    filled = int(width * percent)
    bar = "█" * filled + "░" * (width - filled)
    return f"[{bar}] {int(percent * 100)}%"


# =============================================================================
# Command: status
# =============================================================================

def cmd_status():
    """Show live status table (non-blocking, shows current state, exits)."""
    config = AIWorkerConfig.from_env()
    
    # Get engine status
    engine = SequentialEngine(db_path=config.checkpoint_db)
    current = engine.get_current_iteration()
    
    # Get memory usage
    mem = psutil.virtual_memory()
    used_gb = mem.used / (1024 ** 3)
    
    # Get pending approvals
    safety_cage = SafetyCage(config)
    pending = len(safety_cage.get_pending_patches())
    
    # Build status table
    table = Table(
        title="AIWorker Status",
        title_style="bold cyan",
        border_style="blue",
        show_header=False,
        padding=(0, 2)
    )
    
    table.add_column("Label", style="dim", width=20)
    table.add_column("Value", style="white")
    
    # State
    state = current.get('state', 'IDLE') if current else 'IDLE'
    state_color = {
        'IDLE': 'green',
        'PLAN': 'yellow',
        'RESEARCH': 'blue',
        'CODE': 'magenta',
        'VALIDATE': 'cyan',
        'APPLY': 'bright_yellow',
        'LEARN': 'bright_green',
        'ERROR': 'red',
        'PAUSED': 'dim'
    }.get(state, 'white')
    
    table.add_row("State", f"[{state_color}]{state}[/{state_color}]")
    
    # Iteration ID
    if current:
        table.add_row("Iteration", current.get('iteration_id', 'N/A'))
        
        # Duration
        started = current.get('started_at')
        if started:
            duration = time.time() - started
            table.add_row("Duration", format_duration(duration))
    
    # Progress (estimated based on state)
    state_progress = {
        'IDLE': (0, 6),
        'PLAN': (1, 6),
        'RESEARCH': (2, 6),
        'CODE': (3, 6),
        'VALIDATE': (4, 6),
        'APPLY': (5, 6),
        'LEARN': (6, 6),
    }
    progress = state_progress.get(state, (0, 6))
    table.add_row("Progress", get_progress_bar(progress[0], progress[1]))
    
    # Memory
    mem_color = "red" if used_gb > 28 else "yellow" if used_gb > 24 else "green"
    table.add_row(
        "Memory",
        f"[{mem_color}]{get_memory_bar(used_gb)}[/{mem_color}]"
    )
    
    # Pending approvals
    pending_color = "yellow" if pending > 0 else "dim"
    table.add_row(
        "Pending Approvals",
        f"[{pending_color}]{pending}[/{pending_color}]"
    )
    
    # Error count
    if current:
        errors = current.get('error_count', 0)
        error_color = "red" if errors > 0 else "dim"
        table.add_row("Errors", f"[{error_color}]{errors}[/{error_color}]")
    
    # Print table
    console.print()
    console.print(table)
    console.print()


