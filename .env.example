# AIWorker environment
# Copy this file to .env and adjust values for your machine.

# Runtime identity and paths.
AIWORKER_APP_NAME=aiworker
AIWORKER_ENV=local
AIWORKER_BASE_PATH=.
AIWORKER_WORKSPACE=./workspace
AIWORKER_DATA_PATH=./data
AIWORKER_LOG_PATH=./logs
AIWORKER_DB_PATH=./data/aiworker.sqlite3
AIWORKER_MEMORY_PATH=./data/agent_memory.jsonl
AIWORKER_LOG_LEVEL=INFO

# Agent loop guards and tool execution policy.
AIWORKER_MAX_ITERATIONS=8
AIWORKER_MAX_ATTEMPTS=4
AIWORKER_MAX_FAILURES=3
AIWORKER_TOOL_TIMEOUT_SECONDS=20
AIWORKER_TOOL_RETRY_ATTEMPTS=1
AIWORKER_RATE_LIMIT_MAX=60
AIWORKER_RATE_LIMIT_WINDOW=60

# Local LLM settings. The maintained sample runner does not require the LLM to be up.
AIWORKER_OLLAMA_HOST=http://localhost:11434
AIWORKER_MODEL=llama3.1
AIWORKER_OLLAMA_TIMEOUT=60
AIWORKER_OLLAMA_TEMPERATURE=0.2
AIWORKER_LLM_ENDPOINT=http://localhost:11434/api/generate

# Optional cloud LLM settings. Leave empty unless explicitly enabled in downstream modules.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Safety, governance, and research defaults.
AIWORKER_SANDBOX_TIMEOUT=120
AIWORKER_CONFIDENCE_THRESHOLD=0.4
AIWORKER_MAX_LINES_CHANGED=100
AIWORKER_AUTO_APPROVE=false
AIWORKER_CIRCUIT_BREAKER_THRESHOLD=3
AIWORKER_HEALTH_CHECK=true
AIWORKER_SEARXNG_URL=http://localhost:8888
AIWORKER_RESEARCH_SOURCES=5
AIWORKER_RAM_BUDGET_GB=28.0
AIWORKER_SWAP_BUDGET_GB=50.0

# Optional interactive features.
AIWORKER_VOICE_ENABLED=false
AIWORKER_VISION_ENABLED=false
AIWORKER_DASHBOARD_WS=false
